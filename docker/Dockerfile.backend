FROM golang:alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,direct
ENV GOTOOLCHAIN=auto

# Скачиваем зависимости (кэш модулей сохраняется между сборками)
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Устанавливаем swag для генерации Swagger документации
RUN --mount=type=cache,target=/go/pkg/mod \
    go install github.com/swaggo/swag/cmd/swag@latest

# Копируем всё остальное
COPY . .

# Генерируем Swagger документацию
RUN swag init -g services/backend/cmd/main.go -d . -o services/backend/docs

# Собираем бинарник (кэш компиляции тоже сохраняется)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o backend ./services/backend/cmd

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/backend .
COPY --from=builder /app/services/backend/web ./services/backend/web

ENV PG_HOST=database
ENV QDRANT_HOST=qdrant

EXPOSE 8080
CMD ["./backend"]
